# HTTP port the server listens on.
PORT=3000

# Public base URL of the site, used for canonical/Open Graph tags, the
# sitemap, and robots.txt. Set this in production (e.g. https://db.example.com).
SITE_URL=http://localhost:3000

# Directory holding the on-disk snapshot of upstream data (~20MB).
DATA_DIR=./data

# When set, POST /api/refresh requires "Authorization: Bearer <token>".
# Leave unset to allow unauthenticated refreshes (fine for local use).
REFRESH_TOKEN=

# Hours between automatic upstream refresh checks. 0 disables auto-refresh.
# A check is a no-op unless the upstream commit SHA has changed.
REFRESH_INTERVAL_HOURS=24

# Upstream data source. Defaults track the SP-Tushonka server fork.
UPSTREAM_REPO=SP-Tushonka/server-csharp
UPSTREAM_BRANCH=main
# Comma-separated candidates; the first that resolves at a given tag is used.
UPSTREAM_DB_PATH=Libraries/SPTarkov.Server.Assets/SPT_Data/database,Libraries/SPTushonka.Server.Assets/SPT_Data/database
LFS_BASE_URL=https://lfs.sp-tushonka.com/sp-tushonka/server-csharp

# Read-only GitHub token used when scanning mod repositories. Unauthenticated API access
# is capped at 60 requests/hour, which is not enough to survey the mod corpus. Public repos
# only need a classic PAT with no scopes selected.
GITHUB_TOKEN=

# Hours between automatic mod syncs. 0 disables it; run `bun run sync` by hand instead.
# Around 25 mods change a day, so daily is the natural cadence.
MOD_SYNC_INTERVAL_HOURS=24

# Minimum lifetime downloads a mod needs before its items are indexed. Downloads only ever
# grow, so a mod that crosses the line later is picked up by a later sync.
MOD_MIN_DOWNLOADS=2000
