# HTTP port the server listens on.
PORT=3000

# Public base URL of the site, used for canonical/Open Graph tags, the
# sitemap, and robots.txt. Set this in production (e.g. https://db.example.com).
SITE_URL=http://localhost:3000

# Directory holding the on-disk snapshot of upstream data (~20MB).
DATA_DIR=./data

# When set, POST /api/refresh requires "Authorization: Bearer <token>".
# Leave unset to allow unauthenticated refreshes (fine for local use).
REFRESH_TOKEN=

# Hours between automatic upstream refresh checks. 0 disables auto-refresh.
# A check is a no-op unless the upstream commit SHA has changed.
REFRESH_INTERVAL_HOURS=24

# Upstream data source. Defaults track the SP-Tushonka server fork.
UPSTREAM_REPO=SP-Tushonka/server-csharp
UPSTREAM_BRANCH=main
UPSTREAM_DB_PATH=Libraries/SPTarkov.Server.Assets/SPT_Data/database
LFS_BASE_URL=https://lfs.sp-tushonka.com/sp-tushonka/server-csharp
